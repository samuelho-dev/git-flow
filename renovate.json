{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for git-flow reusable GitHub workflows",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 GitHub Actions Dependency Dashboard",
  "labels": ["github-actions", "renovate", "dependencies"],
  "schedule": ["after 2am and before 3am every weekday"],
  "timezone": "America/Los_Angeles",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "description": "Pin all GitHub Actions to full SHA for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Automerge digest updates for pinned actions (security patches)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group Docker actions together",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^docker/"],
      "groupName": "Docker actions"
    },
    {
      "description": "Group Kubernetes/Helm actions together",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^helm/", "^azure/.*helm", "^kubernetes/"],
      "groupName": "Kubernetes actions"
    },
    {
      "description": "Group security scanning actions together",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": [
        "^aquasecurity/",
        "^gitleaks/",
        "^anchore/",
        "^github/codeql"
      ],
      "groupName": "Security scanning actions"
    },
    {
      "description": "Official GitHub Actions - low risk, can automerge minor/patch",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^actions/"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major version updates require manual review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update", "needs-review"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "urgent"],
    "automerge": false
  },
  "rebaseWhen": "conflicted",
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**"
  ]
}
